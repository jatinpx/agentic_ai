# LLM provider: ollama (default) or gemini
LLM_PROVIDER=ollama

# Ollama default model (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL_DEFAULT=qwen2.5:7b-instruct

# Gemini configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Free-tier safeguard: reduce LinkedIn pipeline LLM calls (recommended with Gemini free tier)
LINKEDIN_LOW_COST_MODE=true

# Workflow-only testing mode (skip quality-heavy behavior and use cheapest model)
WORKFLOW_TEST_MODE=false
LINKEDIN_TEST_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Tavily (web search)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith (observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=autonomous_ai

# ==========================================
# LinkedIn Content Agent — Per-node models
# ==========================================
# The agent respects LLM_PROVIDER above.
# When LLM_PROVIDER=ollama → LINKEDIN_MODEL_* vars are used.
# When LLM_PROVIDER=gemini → LINKEDIN_GEMINI_MODEL_* vars are used.
# If a per-node var is not set, it falls back to OLLAMA_MODEL_DEFAULT
# or GEMINI_MODEL respectively.
#
# --- Ollama per-node models ---
LINKEDIN_MODEL_INPUT=qwen2.5:7b-instruct
LINKEDIN_MODEL_STYLE_FETCH=qwen2.5:7b-instruct
LINKEDIN_MODEL_VIRAL_FETCH=qwen2.5:7b-instruct
LINKEDIN_MODEL_TREND=qwen2.5:7b-instruct
LINKEDIN_MODEL_TREND_DISCOVERY=qwen2.5:7b-instruct
LINKEDIN_MODEL_QUERY_REFINE=qwen2.5:7b-instruct
LINKEDIN_MODEL_QUERY_GEN=qwen2.5:7b-instruct
LINKEDIN_MODEL_CLAIM_EXTRACT=qwen2.5:7b-instruct
LINKEDIN_MODEL_FACT_VERIFY=qwen2.5:7b-instruct
LINKEDIN_MODEL_ANGLE=qwen2.5:7b-instruct
LINKEDIN_MODEL_POV=qwen2.5:7b-instruct
LINKEDIN_MODEL_HOOK_GEN=qwen2.5:7b-instruct
LINKEDIN_MODEL_WRITER=qwen2.5:7b-instruct
LINKEDIN_MODEL_OPTIMIZER=qwen2.5:7b-instruct
LINKEDIN_MODEL_SCORER=qwen2.5:7b-instruct
#
# --- Gemini per-node models (used when LLM_PROVIDER=gemini) ---
# If not set, falls back to GEMINI_MODEL above.
LINKEDIN_GEMINI_MODEL_INPUT=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_STYLE_FETCH=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_VIRAL_FETCH=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_TREND=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_TREND_DISCOVERY=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_QUERY_REFINE=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_QUERY_GEN=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_CLAIM_EXTRACT=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_FACT_VERIFY=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_ANGLE=gemini-2.5-pro
LINKEDIN_GEMINI_MODEL_POV=gemini-2.5-pro
LINKEDIN_GEMINI_MODEL_HOOK_GEN=gemini-2.0-flash
LINKEDIN_GEMINI_MODEL_WRITER=gemini-2.5-pro
LINKEDIN_GEMINI_MODEL_OPTIMIZER=gemini-2.5-pro
LINKEDIN_GEMINI_MODEL_SCORER=gemini-2.0-flash

# ==========================================
# LinkedIn API (OAuth2)
# ==========================================
# Create an app at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
# Optional: page posting config
# If LINKEDIN_ENABLE_ORG_POSTING=true, OAuth requests org scopes
# (w_organization_social + rw_organization_admin).
# You must re-authenticate after changing this flag/scopes.
LINKEDIN_ENABLE_ORG_POSTING=false
# Set either LINKEDIN_AUTHOR_URN or LINKEDIN_ORGANIZATION_ID for page posting.
# Examples:
# LINKEDIN_AUTHOR_URN=urn:li:organization:123456
# LINKEDIN_ORGANIZATION_ID=123456
LINKEDIN_AUTHOR_URN=
LINKEDIN_ORGANIZATION_ID=
